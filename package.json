    "devDependencies": {
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.9",
        "@types/node": "^18.19.59",
        "@types/restify": "^8.5.12",
        "@types/sinon": "^10.0.20",
        "@types/supertest": "^2.0.16",
        "chai": "^4.5.0",
        "del": "^6.1.1",
        "gulp": "^4.0.2",
        "gulp-istanbul": "^1.1.3",
        "gulp-mocha": "^8.0.0",
        "gulp-sourcemaps": "^3.0.0",
